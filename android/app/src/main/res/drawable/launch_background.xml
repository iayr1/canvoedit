<?xml version="1.0" encoding="utf-8"?>
<!-- The splash on Android 11 and older: the home header's gradient with the logo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/canvo_splash"
                android:centerColor="@color/canvo_splash_mid"
                android:endColor="@color/canvo_splash_end"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
